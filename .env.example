# VerbIA — variables de entorno
# Copia este archivo a .env y rellena los valores reales.

# Clave de Groq (conversación y transcripción Whisper)
GROQ_API_KEY=tu_clave_groq_aqui

# URL de la base de datos PostgreSQL (Supabase o local)
DATABASE_URL=postgresql+psycopg://usuario:password@host:puerto/nombre_bd

# Clave de Fish Audio (voces de los personajes)
FISH_API_KEY=sk-fish-tu_clave_aqui

# IDs de voz de Fish Audio (opcional, se usan valores por defecto si faltan)
FISH_LEONARDO_VOICE_ID=tu_id_de_voz_leonardo
FISH_ANDRES_VOICE_ID=tu_id_de_voz_andres
FISH_LUIS_VOICE_ID=tu_id_de_voz_luis
FISH_MARCOS_VOICE_ID=tu_id_de_voz_marcos
FISH_LUCIA_VOICE_ID=tu_id_de_voz_lucia
FISH_NOVA_VOICE_ID=tu_id_de_voz_nova

# Google OAuth (inicio de sesión con Google)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Secreto para firmar sesiones (mínimo 32 caracteres)
SESSION_SECRET=una_clave_secreta_de_al_menos_32_caracteres

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Entorno: desarrollo o producción
ENVIRONMENT=development